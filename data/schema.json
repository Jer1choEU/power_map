{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Power Map dataset v1",
  "type": "object",
  "required": [
    "version",
    "mode",
    "entities",
    "sources",
    "relations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "demo",
        "real"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "persona",
              "impresa",
              "istituzione",
              "media"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "accessedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publisher": {
            "type": "string"
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "accessedAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "type",
          "label",
          "validFrom",
          "validTo",
          "sourceIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "incarico",
              "partecipazione",
              "collaborazione"
            ]
          },
          "label": {
            "type": "string"
          },
          "validFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "validTo": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "additionalProperties": false
}
